# Provider credentials for reels-maker media-search / media-download.
# Copy this file to .env (git-ignored) and fill in real values.
# Process environment variables take precedence over this file.

# Pexels photos + videos API — https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay photos + videos API — https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Unsplash photos API — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Openverse OAuth bearer token — optional. Without it, searches use the
# API's anonymous tier (20 req/min, 200/day), which is fully supported.
OPENVERSE_ACCESS_TOKEN=

# ElevenLabs text-to-speech API key — required by `reels-maker tts-generate`
# and `reels-maker tts-voices`. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
