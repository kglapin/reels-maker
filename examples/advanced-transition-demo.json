      "headline": "CONSECTETUR ELIT",
      "subtitle": "SEQUENCES / CONNECTION / FLOW",
      "icon_library": "lucide",
      "icon_style": "outline",
      "icon_names": {
        "sun": "sun",
        "house": "house",
        "battery": "battery-charging",
        "arrow": "arrow-right"
      },
      "transition_out": {
        "type": "pixel-dissolve",
        "duration": 0.58,
        "color": "#47A013",
        "anchor": [
          0.5,
          0.5
        ]
      }
    },
    {
      "id": "11-checklist",
      "composition": "checklist",
      "duration": 1.8,
      "transition_in": "cut",
      "background": {
        "kind": "solid",
        "color": "#161122"
      },
      "headline": "BUILT TO MOVE",
      "items": [
        "LOREM IPSUM DOLOR",
        "SIT AMET CONSECTETUR",
        "ADIPISCING TEMPOR",
        "MAGNA ALIQUA"
      ],
      "icon_library": "heroicons",
      "icon_style": "outline",
      "icon_names": {
        "check": "check-circle"
      }
    }
