        {
          "label": "LOREM",
          "value": 24,
          "suffix": "K"
        },
        {
          "label": "IPSUM",
          "value": 78,
          "suffix": "%"
        },
        {
          "label": "DOLOR",
          "value": 12,
          "suffix": "X"
        },
        {
          "label": "AMET",
          "value": 360,
          "suffix": "°"
        }
      ],
      "transition_out": {
        "type": "spin-zoom",
        "duration": 0.58,
        "color": "#47A013",
        "anchor": [
          0.5,
          0.5
        ]
      }
    },
    {
      "id": "10-energy",
      "composition": "energy",
      "duration": 1.8,
      "transition_in": "cut",
      "theme": "light",
      "background": {
        "kind": "solid",
        "color": "#F5F2ED"
