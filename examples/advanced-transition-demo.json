        "type": "split-slide",
        "duration": 0.58,
        "color": "#47A013",
        "anchor": [
          0.5,
          0.5
        ]
      }
    },
    {
      "id": "06-ring",
      "composition": "donut",
      "duration": 1.8,
      "transition_in": "cut",
      "background": {
        "kind": "solid",
        "color": "#100F19"
      },
      "headline": "TEMPOR INCIDIDUNT",
      "value": 84,
      "label": "IPSUM",
      "subtitle": "UT LABORE ET DOLORE",
      "transition_out": {
        "type": "iris-close-open",
        "duration": 0.58,
        "color": "#47A013",
        "anchor": [
          0.5,
          0.5
        ]
      }
    },
    {
      "id": "09-stats",
      "composition": "stats",
      "duration": 1.8,
      "transition_in": "cut",
      "background": {
        "kind": "solid",
        "color": "#19142C"
      },
      "headline": "METRICS IN MOTION",
