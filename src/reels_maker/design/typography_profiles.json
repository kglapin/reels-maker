  "attribution": "Reels Maker original video adaptations informed by external typographic design systems. Values are recommendations, NOT official platform requirements.",
  "source_references": [
    {
      "id": "carbon",
      "name": "IBM Carbon — Type Sets",
      "url": "https://www.carbondesignsystem.com/building-blocks/foundations/typography/type-sets",
      "lesson": "Assign named roles and pairing rules instead of arbitrary per-text values."
    },
    {
      "id": "material3",
      "name": "Google Material 3 — Typography",
      "url": "https://developer.android.com/develop/ui/compose/designsystems/material3",
      "lesson": "Display/headline/title/body/label semantic tiering with size and leading tokens."
    },
    {
      "id": "ibm",
      "name": "IBM Design Language — Type Scale",
      "url": "https://www.ibm.com/design/language/typography/type-scale/",
      "lesson": "Controlled relative scale, increasing line-height ratio for smaller and longer copy."
    },
    {
      "id": "uswds",
      "name": "U.S. Web Design System — Typography",
      "url": "https://designsystem.digital.gov/components/typography/",
      "lesson": "Readability: constrained line measure, leading, tracking, white space and grouping."
    },
    {
      "id": "gov-type",
      "name": "GOV.UK — Type Scale",
      "url": "https://design-system.service.gov.uk/styles/type-scale/",
      "lesson": "Size and leading treated as a paired, responsive system."
    },
    {
      "id": "gov-social",
      "name": "GOV.UK — Social Typography",
      "url": "https://brand.design-system.service.gov.uk/typography/social/",
      "lesson": "Positive/negative social-asset examples of consistent line/letter spacing."
    },
    {
      "id": "atlassian",
      "name": "Atlassian — Applying Typography",
      "url": "https://atlassian.design/foundations/typography/applying-typography",
      "lesson": "Clear heading/body hierarchy without unrelated style changes."
    },
    {
      "id": "material-grid",
      "name": "Material Design — Metrics & Keylines",
      "url": "https://m1.material.io/layout/metrics-keylines.html",
      "lesson": "Use an aligned 8-unit rhythm for layout, 4-unit type baselines in UI; adapt to video."
    },
    {
      "id": "adobe-safe",
      "name": "Adobe Premiere — Safe Zones",
      "url": "https://helpx.adobe.com/uk/premiere/desktop/get-started/source-and-program-monitor-adjustments/view-safe-zones-in-the-monitors.html",
      "lesson": "Verify titles in platform/format safe margins in actual video previews."
    },
    {
      "id": "wcag-spacing",
      "name": "W3C — Understanding Text Spacing",
      "url": "https://www.w3.org/WAI/WCAG22/Understanding/text-spacing",
      "lesson": "Text-spacing override test is designed for adjustable markup; do not impose 1.5 line-height on MP4 headlines."
    }
  ],
